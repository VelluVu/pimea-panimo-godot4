.godot/
*.translation

.godot/mono/
msbuild.log

.DS_Store
Thumbs.db

.claude/settings.json

notes/
# Cheat command sets stay local (see dev_console.gd)
src/console/batch_cheat_commands.gd*
src/console/world_cheat_commands.gd*
src/console/dev_mode_commands.gd*

# Generated by dev/tools/sheets.py export
dev/tools/sheets/*.xlsx

# Present only during automated test runs; mutes the game (see audio_wiring.gd)
dev/mute_audio.flag

# Output of dev/tools/playtest/playtest.py run
dev/tools/playtest/runs/
# Raw tracker exports (rebuilt from the .fur project; the game uses the OGG in assets/)
dev/music/*.wav
__pycache__/

# Web export output
build/
dev/tools/web/out/

