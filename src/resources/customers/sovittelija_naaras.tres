dialogue_success = "Neuvottelutulos! Kolmannella kulauksella osapuolet jo halailivat. Kirjataan pöytäkirjaan."
dialogue_fallback = "Tämä ei miellytä ketään täysin. Siitä tunnistaa hyvän kompromissin."
dialogue_wrong_style = "Tätä ei ollut esityksessäni, mutta hyväksyn sen eriävän mielipiteen kera."
dialogue_reject = "Tämä vaarantaa työrauhan. Jätän esityksen pöydälle ja tuopin myös."
dialogue_no_match = "Ei tripeliä? Neuvottelut ovat kariutuneet. Annan lakkovaroituksen."
dialogue_preview_format = "%s... tätä voisin esittää osapuolille."
dialogue_nothing_available = "Hanat tyhjinä. Onko täällä jo työtaistelu? Odotan aamuun, minulla on pullaa."
alt_intro = Array[String](["Kolmas yö putkeen neuvottelupöydässä. Pullat loppuivat, sopu ei ole edes näköpiirissä. Tripeliä, kiitos.", "Tulin hakemaan paikallista sopimista. Kolmen osapuolen olutta, kiitos."])
