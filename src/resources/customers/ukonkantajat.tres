dialogue_intro = "Säännöissä ei sanota, kumpi kantaa. Eukonkanto-olutta, ukon painon verran."
dialogue_success = "Hyvää! Tällä kannetaan ukko maaliin ja vielä takaisinkin."
dialogue_fallback = "Menettelee. Ukkokin on vain menettelevä, ja häntä minä kannan joka päivä."
dialogue_wrong_style = "Väärä olut, mutta en jaksa laskea ukkoa maahan sen takia."
