dialogue_nothing_available = "Tyhjät hanat. Kannoin ukon portaat alas turhaan."
alt_intro = Array[String](["Ukko on kevyempi kuin näyttää, olut painavampaa. Eukonkanto-olutta.", "Ukko tervehtii tuolta takaa. Ylösalaisin, mutta tervehtii."])
alt_success = Array[String](["Juuri tätä. Ukko hihkuu takana, tai sitten hänellä on huono olla.", "Täydellinen. Tällä voitetaan kisat, ja ukko saa juoda palkinnon."])
