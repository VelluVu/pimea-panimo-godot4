dialogue_intro = "Eukonkanto-olutta, vaimon painon verran. Hän sanoo, että se on kuusi pulloa, enkä minä väitä vastaan."
dialogue_success = "Tällä juostaan vesiesteen yli kuivin jaloin. Vaimo kiittää, ylösalaisin."
dialogue_fallback = "Kelpaa. Kantaja ei valitse, kantaja juo."
dialogue_wrong_style = "Ei tämä ole eukonkanto-olutta, mutta otetaan. Takaisin ei jaksa kantaa."
dialogue_reject = "Tällä ei jaksa kantaa edes ostoskassia. Ei käy."
dialogue_no_match = "Ei eukonkanto-olutta? Kannoin hänet tänne ihan turhaan. Hän on samaa mieltä."
dialogue_preview_format = "%s. Vaimo nyökkää, luulisin. Vaikea sanoa tästä kulmasta."
dialogue_nothing_available = "Tyhjää. Ja minä kannoin hänet portaat alas."
alt_intro = Array[String](["Vaimo tilaa täältä alhaalta: eukonkanto-olutta! Minä vain maksan ja kannan.", "Treenataan kisoihin. Hän on reppu, minä olen muuli. Eukonkanto-olutta."])
alt_success = Array[String](["Hyvää! Vaimokin sanoo, että hyvää, vaikka veri on jo päässä.", "Tämä on se palkinto, jonka eteen me treenataan. Ja minä kannan sen kotiin."])
alt_fallback = Array[String](["Ihan juotavaa. Vaimon mukaan ylösalaisin kaikki maistuu vähän oudolta.", "Menee. Kisoissa juodaan mitä annetaan."])
