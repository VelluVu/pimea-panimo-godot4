alt_fallback = Array[String](["Ei ihan witbier, mutta hyvä ravi.", "Kelpaa. Salama ei ole nirso, enkä minäkään."])
alt_wrong_style = Array[String](["Väärä este, mutta hypätään silti.", "Ei witbier. Salama pudisti harjaansa."])
