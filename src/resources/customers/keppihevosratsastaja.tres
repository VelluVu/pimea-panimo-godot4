dialogue_honour = "Keppihevosratsastaja ja Salama tekevät kouluratsastuskumarruksen tiskin edessä! Koko kellari taputtaa, ja Salama saa ruusukkeen."
dialogue_intro = "Hei! Mulle witbier ja Salamalle ämpäri vettä. Se on janoinen laukan jälkeen."
dialogue_success = "Wau! Kevyt ja poreileva, ihan kuin Salaman harja tuulessa."
dialogue_fallback = "Vehnää kuitenkin. Hevonenkin syö kauraa, jos ei muuta ole."
dialogue_wrong_style = "Tää ei ollut tilauksessa, mutta otetaan. Salama, älä katso noin."
dialogue_reject = "Ei. Tälle Salamakin kieltäytyisi esteeltä."
dialogue_no_match = "Ei witbieriä? Tallille sitten. Hyppy, hyppy!"
dialogue_preview_format = "%s! Salama hirnahti, se tarkoittaa kyllä."
dialogue_nothing_available = "Tyhjät hanat? Kuin rata ilman esteitä."
alt_intro = Array[String](["Ihanaa, täällä on hyvä pohja! Salama, seis. Yksi witbier.", "Hypättiin portaat kolmella askeleella. Witbier, kiitos!"])
