dialogue_honour = "Lavatanssija niiaa: Saanko luvan? Pyörähdätte valssin tiskin edessä, ja koko kellari taputtaa."
dialogue_intro = "Saanko luvan? Ensin tuoppi, sitten valssi. Yksi wieniläinen lager, kiitos."
dialogue_success = "Kuin valssi Wienissä! Yksi, kaksi, kolme... ja kulaus."
dialogue_fallback = "Ei ihan valssia, mutta reipas foksi. Kelpaa."
