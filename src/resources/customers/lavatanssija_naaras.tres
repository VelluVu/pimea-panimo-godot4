dialogue_nothing_available = "Tyhjät hanat. Kuin tanssilava ilman orkesteria."
alt_intro = Array[String](["Naistenhakuun on vielä tunti. Ehdin yhden lagerin.", "Kengät kiiltää ja polvet kestää. Yksi wieniläinen."])
