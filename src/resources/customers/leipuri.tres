dialogue_intro = "Huomenta! Uunit lämpenee jo neljältä, nyt kelpaisi jotain makeaa. Onko maitostouttia, pullan kaveriksi?"
dialogue_success = "Täyteläistä ja makeaa kuin tuore korvapuusti! Tämän perään jaksaa taas vaivata taikinaa."
dialogue_fallback = "Ei ihan pullan kaveri, mutta maltaista makeutta löytyy. Kelpaa."
dialogue_wrong_style = "Tilasin viinerin ja sain ruisleipää. No, juodaan."
dialogue_reject = "Tämä on pohjaan palanut. Ei kelpaa leipurille."
