dialogue_nothing_available = "Hyllyt tyhjinä kuin leipälaari maanantaiaamuna..."
alt_intro = Array[String](["Huomenta! Taikina nousee, joten ehdin yhdelle. Jotain makeaa ja tummaa.", "Jauhot on vielä esiliinassa. Maitostouttia, kiitos, pullan kaveriksi."])
alt_success = Array[String](["Makeaa kuin kardemummapulla. Täydellistä.", "Tämä on kuin vastapaistettu leipä. Tuoksuu ja maistuu."])
alt_fallback = Array[String](["Ei aivan pullan kaveri, mutta kahvin kanssa menisi.", "Kelpaa. Leipuri ei heitä mitään hukkaan."])
alt_wrong_style = Array[String](["Tilasin makeaa, sain karvasta. No, ei kaikki pullatkaan onnistu.", "Ei tätä tilattu, mutta juodaan, kun uuni on vielä kuuma."])
alt_reject = Array[String](["Tämä on kuin eilinen pulla. Ei kiitos.", "Liian karvasta. Tällä pilaisi koko pellillisen."])
