[ext_resource type="Script" path="res://src/customers/sour_reactions.gd" id="1_sour"]

[resource]
script = ExtResource("1_sour")
light_lines = Array[String](["Onko tämä tarkoituksella näin kirpeää?", "Hmm, tässä on jotain hapanta. Uusi trendi?", "Vähän kuin hapankaali, mutta juotavaa."])
