[gd_resource type="Resource" script_class="GuideSection" format=3]

[ext_resource type="Script" path="res://src/ui/guide_section.gd" id="1_guide"]

[resource]
script = ExtResource("1_guide")
order = 60
title = "Tasot ja tavoitteet"
lines = Array[String](["Keittäminen ja myynti antavat kokemusta. Uudella tasolla valitset yhden kolmesta edusta loppukaudeksi.", "Tavoitteet-paneeli oikealla näyttää päivän tavoitteet. Otsikon luku kertoo, montako uutta tavoitetta tänään vielä tulee, ja suoritetut tavoitteet antavat palkintoja.", "Otsikon alle ilmestyy Seuraavaksi-rivi, kun peli tietää, mitä kannattaa tehdä: ensimmäisenä päivänä se neuvoo ensimmäisen oluen panemisessa, myöhemmin se muistuttaa, kun hanat ovat tyhjät.", "Epäonnistunut tavoite maksaa vähän mainetta, paitsi ensimmäisenä päivänä.", "Vie tynnyri baariin -tavoitteeseen lasketaan vain täysi tynnyri: erässä pitää olla vähintään 40 annosta. Vajaankin erän voi silti viedä baariin."])
