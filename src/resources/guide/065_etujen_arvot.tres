[gd_resource type="Resource" script_class="GuideSection" format=3]

[ext_resource type="Script" path="res://src/ui/guide_section.gd" id="1_guide"]

[resource]
script = ExtResource("1_guide")
order = 7
title = "Etujen arvot"
lines = Array[String](["Etujen arvot näkyvät kahdella tavalla: +15 % tai ×1.15.", "+ %: lasketaan yhteen muiden samanlaisten etujen kanssa. Kaksi +15 % etua tipeille antaa yhteensä +30 %.", "×: kertoo kokonaisuuden. Kaksi ×1.15 etua tipeille antaa 1.15 × 1.15 = ×1.32, eli enemmän kuin kaksi +15 % etua.", "Kun samaan asiaan on molempia, ×-arvot kerrotaan ensin keskenään ja + % lisätään lopuksi. ×1.20 ja +20 % antavat yhteensä ×1.40.", "Alle 1 oleva kerroin pienentää: Ainesten hinnat ×0.90 tarkoittaa 10 % halvempia aineksia.", "+ % -edut kasvavat tasaisesti, ×-edut sitä nopeammin, mitä useampi niitä on.", "Kauden tilastot -ikkunassa näet kaikki etusi ja niiden yhteisvaikutuksen."])
