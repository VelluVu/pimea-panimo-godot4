[gd_resource type="Resource" script_class="GuideSection" format=3]

[ext_resource type="Script" path="res://src/ui/guide_section.gd" id="1_guide"]

[resource]
script = ExtResource("1_guide")
order = 70
title = "Etujen arvot"
lines = Array[String](["Etujen arvot näkyvät kahdella tavalla: 15 % tai ×15 %. Teksti kertoo, kasvattaako vai pienentääkö etu arvoa.", "15 %: lasketaan yhteen muiden samanlaisten etujen kanssa. Kaksi 15 %:n etua tipeille kasvattaa niitä yhteensä 30 %.", "×15 %: kertautuu muiden kanssa. Kaksi ×15 %:n etua tipeille kasvattaa niitä yhteensä 32 %.", "Kauden tilastot -ikkunassa näet kaikki etusi ja niiden yhteisvaikutuksen."])
