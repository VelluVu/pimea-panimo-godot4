[gd_resource type="Resource" script_class="GuideSection" format=3]

[ext_resource type="Script" path="res://src/ui/guide_section.gd" id="1_guide"]

[resource]
script = ExtResource("1_guide")
order = 70
title = "Etujen arvot"
lines = Array[String](["Etujen arvot näkyvät prosentteina: +15 % kasvattaa, -15 % pienentää.", "Raaka-aineiden hinnat: -10 % tarkoittaa 10 % halvempia raaka-aineita.", "Useimmat samaan asiaan vaikuttavat edut kertautuvat keskenään: kaksi +15 %:n etua tipeille antaa yhteensä vähän yli +30 %.", "Kauden tilastot -ikkunassa näet kaikki etusi ja niiden yhteisvaikutuksen."])
