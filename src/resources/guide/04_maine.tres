[ext_resource type="Script" path="res://src/ui/guide_section.gd" id="1_guide"]

[resource]
script = ExtResource("1_guide")
order = 4
title = "Maine"
lines = Array[String](["Maine kasvaa myynneistä ja tavoitteista. Mitä korkeampi maine, sitä hitaammin se kasvaa.", "Maine avaa uusia aineksia ja tuo uusia asiakkaita.", "Kuuluisa panimo herättää myös LVV:n huomion, joten korkeampi maine laskee ratsiarajaa."])
