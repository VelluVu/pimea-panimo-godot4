[gd_resource type="Resource" script_class="GuideSection" format=3]

[ext_resource type="Script" path="res://src/ui/guide_section.gd" id="1_guide"]

[resource]
script = ExtResource("1_guide")
order = 3
title = "Myynti ja asiakkaat"
lines = Array[String](["Asiakkaat ostavat annoksia varaston tynnyreistä. Suosikkityyli tuo enemmän mainetta ja tippejä.", "Nirsot asiakkaat haluavat tietyn laadun. Asiakkaat-välilehti kertoo, mistä kukin pitää.", "Tyytyväinen asiakas tuo kavereita ja voi ryhtyä kanta-asiakkaaksi.", "Varaston Tynnyrit-välilehdeltä erän voi myydä tukkuun tai lähettää baariin."])
