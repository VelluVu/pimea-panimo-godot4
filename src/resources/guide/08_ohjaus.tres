[gd_resource type="Resource" script_class="GuideSection" format=3]

[ext_resource type="Script" path="res://src/ui/guide_section.gd" id="1_guide"]

[resource]
script = ExtResource("1_guide")
order = 90
title = "Ohjaus"
lines = Array[String](["Hiirellä lisätiedot näkyvät, kun osoitin on kohteen päällä. Harmaan napin lisätiedot kertovat, miksi se ei vielä toimi.", "Ensimmäisenä päivänä kultainen nuoli ja kehys näyttävät, mihin painaa seuraavaksi.", "Kosketusnäytöllä pidä sormea kohteen päällä hetki.", "Kosketusnäytöllä ?-nappi vasemmassa alakulmassa näyttää paikkojen nimet.", "Esc sulkee avoimet ikkunat tai avaa valikon."])
