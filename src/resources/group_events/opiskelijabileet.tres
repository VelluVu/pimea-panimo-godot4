[gd_resource type="Resource" script_class="GroupVisitEventData" format=3]

[ext_resource type="Script" path="res://src/classes/group_visit_event_data.gd" id="1_event"]
[ext_resource type="Resource" path="res://src/resources/customers/opiskelija.tres" id="2_customer"]
[ext_resource type="Resource" path="res://src/resources/customers/opiskelija_naaras.tres" id="3_customer_naaras"]

[resource]
script = ExtResource("1_event")
banner_text = "Fuksivuosikurssi ryntää ovesta sisään haalarit päällä —
halvinta kaljaa heti tiskiin!"
