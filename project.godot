; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pimea Panimo"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/textures/icon.svg"

[autoload]

GUISignals="*uid://blglgg64fcgx6"
BrewerySignals="*uid://c7qf7wkp1jef8"
IngredientDatabase="*uid://dexbsgkyojbsd"
BrewEngine="*uid://v1ldxk71j6xp"
StringContainer="*uid://dpid4q4x5pp7w"
TimeManager="*uid://bt32vf1r28xyy"
CustomerManager="*uid://dlbx6ek8v84lo"
CustomerRegistry="*uid://dacwk1mw8xwd"
SpecialEventManager="*uid://dbhnuasgj7gqg"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
SettingsManager="*res://src/autoload/settings_manager.gd"
SaveManager="*res://src/autoload/save_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/dev_resource_tools/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/pp_test_tools/plugin.cfg")

[gui]

timers/tooltip_delay_sec=0.15

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
